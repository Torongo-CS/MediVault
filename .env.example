# Copy to .env.local and fill in. `bunx convex dev` writes CONVEX_DEPLOYMENT for you
# and prints the deployment URL to use for PUBLIC_CONVEX_URL.

# Convex deployment URL, e.g. https://your-project-123.convex.cloud
PUBLIC_CONVEX_URL=

# Managed by the Convex CLI, e.g. dev:your-project-123
CONVEX_DEPLOYMENT=

# The fixed admin account is NOT stored here — it lives in the Convex deployment's
# own environment so the password never touches this repo:
#
#   bunx convex env set ADMIN_EMAIL admin@medivault.com
#   bunx convex env set ADMIN_PASSWORD '<a strong password>'
#   bunx convex run seed:createAdmin
